---
// FASE 4: Layout Base de la aplicación
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Barbería El Estilo - Reserva tu cita', 
  description = 'Agenda tu cita en la mejor barbería. Cortes modernos, servicio profesional.' 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet" />
    
    <title>{title}</title>
  </head>
  <body class="min-h-screen dark">
    <!-- Header -->
    <header class="navbar sticky top-0 z-50">
      <div class="container mx-auto px-4 flex justify-between items-center">
        <a href="/" class="btn btn-ghost text-xl font-display flex items-center gap-2">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 0L4 4m5.121 5.121L4 14"/>
          </svg>
          <span class="hidden sm:inline">Barbería El Estilo</span>
          <span class="sm:hidden">El Estilo</span>
        </a>
        <div class="flex items-center gap-2">
          <!-- Admin Button: Icon only on mobile, Text on Desktop -->
          <a href="/admin" class="btn btn-outline btn-sm px-2 md:px-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span class="hidden md:inline ml-1">Admin</span>
          </a>
          
          <a href="/booking" class="btn btn-primary btn-sm px-3 md:px-4">
            Reservar
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-16 py-10 md:py-16 bg-gradient-to-t from-barber-darker to-transparent border-t border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <div class="mb-6">
            <p class="text-2xl md:text-3xl font-display font-bold text-gradient mb-2">
              Barbería El Estilo
            </p>
            <p class="text-gray-400">Estilo, clase y tradición desde 2020</p>
          </div>
          
          <div class="mb-6 text-sm md:text-base text-gray-400 space-y-2">
            <p class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span>{import.meta.env.PUBLIC_BARBER_ADDRESS || 'Calle Principal #123, Ciudad'}</span>
            </p>
            <p class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <span>{import.meta.env.PUBLIC_BARBER_PHONE || '+52 123 456 7890'}</span>
            </p>
          </div>

          <div class="pt-6 border-t border-primary/10">
            <p class="text-xs text-gray-500">
              © {new Date().getFullYear()} Barbería El Estilo - Todos los derechos reservados
            </p>
          </div>
        </div>
      </div>
    </footer>
    <!-- Botón flotante de Mi Reserva (se muestra si hay reserva activa) -->
    <a id="mi-reserva-btn" href="#" class="fixed bottom-6 right-6 btn btn-primary shadow-lg z-40 hidden animate-slide-up gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
      </svg>
      Mi Reserva
    </a>

    <script>
      // Verificar si hay reserva activa al cargar
      document.addEventListener('DOMContentLoaded', () => {
        const reservaData = localStorage.getItem('barber_reserva_activa');
        if (reservaData) {
          try {
            const { id, timestamp } = JSON.parse(reservaData);
            const now = Date.now();
            const horas48 = 48 * 60 * 60 * 1000;

            // Si tiene menos de 48 horas, mostrar botón
            if (now - timestamp < horas48) {
              const btn = document.getElementById('mi-reserva-btn');
              if (btn) {
                btn.href = `/reserva/${id}`;
                btn.classList.remove('hidden');
                btn.classList.add('flex');
              }
            } else {
              // Si expiró, limpiar
              localStorage.removeItem('barber_reserva_activa');
            }
          } catch (e) {
            console.error('Error al leer reserva local', e);
          }
        }
      });
    </script>
  </body>
</html>
