---
// Panel de administración - Vista de todas las reservas
import Layout from '../../layouts/Layout.astro';
import { validateSessionFromCookies } from '../../utils/auth';
import { Icon } from 'astro-icon/components';

// Verificar autenticación
const cookieHeader = Astro.request.headers.get('cookie');
const isAuthenticated = await validateSessionFromCookies(cookieHeader);

if (!isAuthenticated) {
  return Astro.redirect('/admin/login');
}
---

<Layout title="Admin - Reservas">
  <div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
      <div>
        <h1 class="text-3xl md:text-4xl font-display font-bold text-gradient">Panel de Administración</h1>
        <p class="text-gray-400 mt-2 text-sm md:text-base">Gestiona todas las reservas de la barbería</p>
      </div>
      <div class="flex flex-wrap gap-3 w-full md:w-auto">
        <button id="logout-btn" class="btn btn-outline gap-2 flex-1 md:flex-none">
          <Icon name="mdi:logout" class="w-5 h-5" /> Cerrar Sesión
        </button>
        <a href="/" class="btn btn-outline gap-2 flex-1 md:flex-none">
          <Icon name="mdi:arrow-left" class="w-5 h-5" /> Volver al Inicio
        </a>
      </div>
    </div>

    <!-- Filtros -->
    <div class="card mb-6">
      <div class="card-body">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="form-control">
            <label class="label">
              <span class="label-text">Fecha desde</span>
            </label>
            <input type="date" id="fecha-desde" class="input" />
          </div>
          <div class="form-control">
            <label class="label">
              <span class="label-text">Fecha hasta</span>
            </label>
            <input type="date" id="fecha-hasta" class="input" />
          </div>
          <div class="form-control">
            <label class="label">
              <span class="label-text">Estado</span>
            </label>
            <select id="filtro-estado" class="select">
              <option value="todas">Todas</option>
              <option value="pendiente">Pendientes</option>
              <option value="confirmada">Confirmadas</option>
              <option value="completada">Completadas</option>
              <option value="cancelada">Canceladas</option>
            </select>
          </div>
        </div>
        <button id="btn-filtrar" class="btn btn-primary mt-4 gap-2">
          <Icon name="mdi:filter-variant" class="w-5 h-5" /> Filtrar Reservas
        </button>
      </div>
    </div>

    <!-- Estadísticas rápidas -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <div class="card bg-primary/10 border-primary/30">
        <div class="card-body p-4 sm:p-6">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-xs text-gray-400">Total Reservas</div>
              <div class="text-2xl sm:text-3xl font-bold text-primary" id="stat-total">0</div>
            </div>
            <div class="p-2 sm:p-3 bg-primary/20 rounded-full">
              <Icon name="mdi:calendar-month" class="w-6 h-6 sm:w-8 sm:h-8 text-primary" />
            </div>
          </div>
        </div>
      </div>
      <div class="card bg-blue-500/10 border-blue-500/30">
        <div class="card-body p-4 sm:p-6">
          <div class="flex items-center justify-between">
             <div>
              <div class="text-xs text-gray-400">Pendientes</div>
              <div class="text-2xl sm:text-3xl font-bold text-blue-400" id="stat-pendientes">0</div>
            </div>
            <div class="p-2 sm:p-3 bg-blue-500/20 rounded-full">
              <Icon name="mdi:clock-time-four-outline" class="w-6 h-6 sm:w-8 sm:h-8 text-blue-400" />
            </div>
          </div>
        </div>
      </div>
      <div class="card bg-green-500/10 border-green-500/30">
        <div class="card-body p-4 sm:p-6">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-xs text-gray-400">Confirmadas</div>
              <div class="text-2xl sm:text-3xl font-bold text-green-400" id="stat-confirmadas">0</div>
            </div>
            <div class="p-2 sm:p-3 bg-green-500/20 rounded-full">
              <Icon name="mdi:check-circle-outline" class="w-6 h-6 sm:w-8 sm:h-8 text-green-400" />
            </div>
          </div>
        </div>
      </div>
      <div class="card bg-purple-500/10 border-purple-500/30">
         <div class="card-body p-4 sm:p-6">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-xs text-gray-400">Completadas</div>
              <div class="text-2xl sm:text-3xl font-bold text-purple-400" id="stat-completadas">0</div>
            </div>
            <div class="p-2 sm:p-3 bg-purple-500/20 rounded-full">
              <Icon name="mdi:star-outline" class="w-6 h-6 sm:w-8 sm:h-8 text-purple-400" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabla de reservas -->
    <div class="card">
      <div class="card-body">
        <div id="loading" class="text-center py-8">
          <div class="loading loading-spinner loading-lg text-primary"></div>
          <p class="mt-4 text-gray-400">Cargando reservas...</p>
        </div>
        
        <div id="reservas-container" class="hidden">
          <div class="overflow-x-auto">
            <table class="table w-full">
              <thead>
                <tr class="border-b border-primary/20">
                  <th>Fecha</th>
                  <th>Hora</th>
                  <th>Cliente</th>
                  <th>Teléfono</th>
                  <th>Servicio</th>
                  <th>Estado</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody id="reservas-tbody">
                <!-- Contenido dinámico -->
              </tbody>
            </table>
          </div>
        </div>

        <div id="no-reservas" class="hidden text-center py-12">
          <Icon name="mdi:calendar-remove" class="w-20 h-20 mx-auto mb-4 text-gray-500" />
          <p class="text-xl text-gray-400">No hay reservas para mostrar</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Cancelación -->
  <dialog id="cancel-modal" class="modal">
    <div class="modal-box bg-dark-card border border-primary/20">
      <h3 class="text-2xl font-bold text-gradient mb-4">Cancelar Reserva</h3>
      
      <div class="mb-4">
        <p class="text-gray-300 mb-2">Reserva seleccionada:</p>
        <div id="cancel-reserva-info" class="p-3 bg-primary/10 rounded-lg text-sm">
          <!-- Se llenará dinámicamente -->
        </div>
      </div>

      <div class="form-control mb-6">
        <label class="label">
          <span class="label-text font-semibold">Motivo de cancelación *</span>
        </label>
        <textarea
          id="cancel-reason"
          class="textarea w-full h-24"
          placeholder="Ej: No hay disponibilidad de barbero, Emergencia personal, etc."
          required
        ></textarea>
        <label class="label">
          <span class="label-text-alt text-gray-400">Este motivo será visible para el cliente</span>
        </label>
      </div>

      <div class="flex gap-3 justify-end">
        <button 
          class="btn btn-outline" 
          onclick="document.getElementById('cancel-modal').close()"
        >
          Cancelar
        </button>
        <button 
          id="confirm-cancel-btn"
          class="btn btn-error gap-2"
        >
          <Icon name="mdi:alert-circle-outline" class="w-5 h-5" /> Confirmar Cancelación
        </button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
</Layout>

<script>
  import { initAdminPanel } from '../../components/AdminPanel';
  
  document.addEventListener('DOMContentLoaded', () => {
    initAdminPanel();
    
    // Manejar logout
    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        try {
          await fetch('/api/admin/logout', { method: 'POST' });
          window.location.href = '/admin/login';
        } catch (error) {
          console.error('Error al cerrar sesión:', error);
          // Redirigir de todos modos
          window.location.href = '/admin/login';
        }
      });
    }
  });
</script>

<style>
  .table {
    border-collapse: collapse;
  }
  
  .table th {
    padding: 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--barber-gold);
    white-space: nowrap; /* Evitar saltos de línea en encabezados */
  }
  
  .table td {
    padding: 1rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.1);
    white-space: nowrap; /* Evitar que las celdas se rompan feo en móvil */
  }

  @media (max-width: 640px) {
    .table th, .table td {
      padding: 0.75rem 0.5rem; /* Menos padding en móvil */
    }
  }
  
  .table tbody tr:hover {
    background: rgba(212, 175, 55, 0.05);
  }
</style>
