# Firebase Configuration (Público - Frontend)
PUBLIC_FIREBASE_API_KEY=your_api_key_here
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
PUBLIC_FIREBASE_APP_ID=your_app_id

# Telegram Bot (PRIVADO - Solo Backend)
# ⚠️ NUNCA uses el prefijo PUBLIC_ en estas variables
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Configuración de la Barbería
PUBLIC_BARBER_NAME="Barbería El Estilo"
PUBLIC_BARBER_PHONE="+52 123 456 7890"
PUBLIC_BARBER_ADDRESS="Calle Principal #123, Ciudad"
